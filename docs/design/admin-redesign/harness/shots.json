      "split": [
        800
      ]
    },
    {
      "name": "community",
      "path": "/admin#community",
      "waitFor": "text=링클이 낸 문제",
      "displayScale": 0.5,
      "pins": [
        {
          "n": 7,
          "loc": "text=312명 도전, 221명 도착"
        }
      ]
    },
    {
      "name": "add",
      "path": "/admin#add",
      "waitFor": "text=출발과 도착 고르기",
