{
  "dist": "../../../../apps/web/dist",
  "mocks": "./mocks.mjs",
  "apiPrefix": "/api/",
  "viewport": [
    1280,
    800
  ],
  "scale": 2,
  "allowHosts": [
    "cdn.jsdelivr.net",
    "fonts.googleapis.com",
    "fonts.gstatic.com"
  ],
  "shots": [
    {
      "name": "overview",
      "path": "/admin#overview",
      "waitFor": "text=날짜별 오늘의 문제",
      "viewport": [
        1280,
        1240
      ],
      "displayScale": 0.5,
      "pins": [
        {
          "n": 1,
          "loc": "css=main section >> nth=0"
        },
        {
          "n": 2,
          "loc": "role=heading[name=\"날짜별 오늘의 문제\"]"
        },
        {
          "n": 5,
          "loc": "role=button[name=\"다른 문제로\"]"
        },
        {
          "n": 6,
          "loc": "text=96명 도전, 61명 도착 (64%)"
        }
      ],
      "split": [
        800
      ],
      "probe": {
        "페이지 제목": "role=heading[name=\"링클 관리\"]",
        "탭": "role=tablist",
        "탭(선택)": "role=tab[selected=true]",
        "카드": "css=main section >> nth=0",
        "섹션 제목": "role=heading[name=\"날짜별 오늘의 문제\"]",
        "줄": "css=main li >> nth=1",
        "작은 단추": "role=button[name=\"정답 보기\"] >> nth=0",
