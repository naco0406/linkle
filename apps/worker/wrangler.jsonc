{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "linkle",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 무료 요금제에서는 Worker를 거치는 요청만 하루 한도에 들어간다. API만 Worker로 보낸다.
    // /__scheduled는 로컬에서 예약 작업을 손으로 돌리는 주소다(wrangler dev --test-scheduled). 배포에서는 쓰이지 않는다.
    "run_worker_first": ["/api/*", "/__scheduled"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "linkle",
      // 자리 표시다. 배포 전에 `wrangler d1 create linkle`가 알려 주는 id로 바꾼다. 로컬 개발은 이 값과 무관하게 동작한다.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // 한국 시간 00:05부터 03:35까지 30분마다(UTC로 적는다). 어제 것을 모으고, 기록 후보의 경로를 위키백과에서 확인한다.
  // 위키백과가 요청을 거절하면 다음 차례에 이어서 한다. 무료 요금제는 계정당 예약이 5개까지라 하나로 묶었다.
  "triggers": { "crons": ["5,35 15-18 * * *"] },
  "observability": { "enabled": true }
}
