{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "linkle",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 무료 요금제에서는 Worker를 거치는 요청만 하루 한도에 들어간다. API만 Worker로 보낸다.
    // /__scheduled는 로컬에서 예약 작업을 손으로 돌리는 주소다(wrangler dev --test-scheduled). 배포에서는 쓰이지 않는다.
    "run_worker_first": ["/api/*", "/__scheduled"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "linkle",
      // 자리 표시다. 배포 전에 `wrangler d1 create linkle`가 알려 주는 id로 바꾼다. 로컬 개발은 이 값과 무관하게 동작한다.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // 매시 5분: 오늘·내일 문제가 비어 있으면 대기열에서 채우고, 어제의 기록을 모으고 확인한다.
  // 할 일이 없으면 DB를 한 번 읽고 끝난다. 위키백과가 잠시 막혀도 다음 시간에 이어서 한다. 무료 요금제는 계정당 예약이 5개까지라 하나로 묶었다.
  "triggers": { "crons": ["5 * * * *"] },
  // 같이 달리기 방(설계 문서 16.3.7). SQLite를 쓰는 Durable Object는 Workers Free 요금제에서 된다
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
