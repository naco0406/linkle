{
  "name": "worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8801",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply linkle --local",
    "db:seed": "node scripts/seed.ts && wrangler d1 execute linkle --local --file=.wrangler/seed.sql"
  },
  "dependencies": {
    "@linkle/core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.1"
  }
}
