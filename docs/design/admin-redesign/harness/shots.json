        "줄 제목": "text=아인슈타인",
        "줄 설명": "text=96명 도전, 61명 도착 (64%)",
        "숫자": "text=2,417"
      }
    },
    {
      "name": "queue",
      "path": "/admin#queue",
      "waitFor": "text=낼 순서",
      "viewport": [
        1280,
        1240
      ],
      "displayScale": 0.5,
      "pins": [
        {
          "n": 3,
          "loc": "css=main ul >> nth=0 >> css=li >> nth=1 >> css=span >> nth=0"
        },
        {
          "n": 4,
          "loc": "text=마라톤 › 그리스 › 북유럽 › 오로라"
        },
        {
          "n": 5,
          "loc": "role=button[name=\"빼기\"] >> nth=1"
